<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="autonomous_robot">

  <xacro:include filename="$(find robot_description)/urdf/properties.xacro" />
  <xacro:include filename="$(find robot_description)/urdf/base.xacro" />
  <xacro:include filename="$(find robot_description)/urdf/sensors.xacro" />
  <xacro:include filename="$(find robot_description)/urdf/gazebo.xacro" />

  <xacro:autonomous_robot />
  <xacro:autonomous_robot_gazebo />

</robot>
