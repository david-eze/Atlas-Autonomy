<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Robot physical parameters.
    Values are deliberately realistic for a small indoor service robot:
    ~15 kg total mass, 0.32 m wheel separation, 0.10 m wheel radius,
    max linear speed 1.2 m/s, max angular speed 1.5 rad/s.
  -->

  <xacro:property name="base_length" value="0.45" />
  <xacro:property name="base_width" value="0.38" />
  <xacro:property name="base_height" value="0.18" />
  <xacro:property name="base_mass" value="11.0" />

  <xacro:property name="wheel_radius" value="0.10" />
  <xacro:property name="wheel_width" value="0.04" />
  <xacro:property name="wheel_mass" value="0.6" />
  <xacro:property name="wheel_separation" value="0.32" />

  <xacro:property name="caster_radius" value="0.03" />
  <xacro:property name="caster_mass" value="0.15" />

  <xacro:property name="laser_mass" value="0.35" />
  <xacro:property name="camera_mass" value="0.25" />
  <xacro:property name="imu_mass" value="0.05" />

  <!--
    Sensor mounting heights above the base top surface.
    laser_link z is measured from base_link origin (base top at +base_height/2).
  -->
  <xacro:property name="laser_height" value="0.22" />
  <xacro:property name="camera_height" value="0.24" />
  <xacro:property name="imu_height" value="0.10" />

  <xacro:property name="max_linear_velocity" value="1.2" />
  <xacro:property name="max_angular_velocity" value="1.5" />
  <xacro:property name="max_linear_acceleration" value="1.0" />
  <xacro:property name="max_angular_acceleration" value="2.0" />

</robot>
