<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Differential-drive robot base.
    TF tree:
      base_link
        ├── left_wheel_link   (continuous joint at x=+0.12)
        ├── right_wheel_link  (continuous joint at x=+0.12)
        ├── caster_link       (fixed, passive support at rear)
        └── (sensor mounts are added in sensors.xacro)
  -->

  <xacro:macro name="autonomous_robot">

    <link name="base_link">
      <inertial>
        <origin xyz="0.0 0.0 ${base_height/2}" rpy="0 0 0" />
        <mass value="${base_mass}" />
        <inertia ixx="0.12" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.18" />
      </inertial>
      <visual>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}" />
        </geometry>
        <material name="base_material">
          <color rgba="0.15 0.15 0.18 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}" />
        </geometry>
      </collision>
    </link>

    <link name="left_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="0.0012" ixy="0.0" ixz="0.0" iyy="0.0006" iyz="0.0" izz="0.0012" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="wheel_material">
          <color rgba="0.06 0.06 0.07 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
    </link>

    <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="left_wheel_link" />
      <origin xyz="0.12 ${wheel_separation/2} ${wheel_radius}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit effort="100" velocity="${max_angular_velocity / wheel_radius}" />
      <dynamics damping="0.5" friction="0.1" />
    </joint>

    <link name="right_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="0.0012" ixy="0.0" ixz="0.0" iyy="0.0006" iyz="0.0" izz="0.0012" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="wheel_material">
          <color rgba="0.06 0.06 0.07 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
    </link>

    <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="right_wheel_link" />
      <origin xyz="0.12 -${wheel_separation/2} ${wheel_radius}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit effort="100" velocity="${max_angular_velocity / wheel_radius}" />
      <dynamics damping="0.5" friction="0.1" />
    </joint>

    <link name="caster_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${caster_mass}" />
        <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.0001" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="caster_material">
          <color rgba="0.2 0.2 0.22 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>
    </link>

    <joint name="caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="caster_link" />
      <origin xyz="-0.22 0 ${caster_radius}" rpy="0 0 0" />
    </joint>

  </xacro:macro>

</robot>
